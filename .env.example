# Local development values. Never commit a real production secret.
SECRET_KEY=change-me

# Render example: sqlite:////opt/render/project/src/storage/repair.db
DATABASE_URL=sqlite:///repair.db

# Render example: /opt/render/project/src/storage/uploads
UPLOAD_FOLDER=static/uploads

MAX_CONTENT_LENGTH=5242880

# Set APP_ENV=production on production platforms that do not set RENDER=true.
APP_ENV=development
